import heapq

start = (1,2,3,4,0,6,7,5,8)
goal = (1,2,3,4,5,6,7,8,0)

def h(s):
    return sum(abs(i//3-(x-1)//3) +
               abs(i%3-(x-1)%3)
               for i,x in enumerate(s) if x)

def astar():
    q = [(h(start), 0, start, [])]
    seen = set()

    while q:
        f, g, s, path = heapq.heappop(q)

        if s in seen:
            continue

        seen.add(s)
        path = path + [s]

        if s == goal:
            for x in path:
                print(x[:3], x[3:6], x[6:])
            return

        z = s.index(0)

        for d in [-3, 3, -1, 1]:
            n = z+d

            if 0 <= n < 9 and not (
                d == -1 and z%3 == 0 or
                d == 1 and z%3 == 2
            ):
                t = list(s)
                t[z], t[n] = t[n], t[z]
                t = tuple(t)

                if t not in seen:
                    heapq.heappush(q, (g+1+h(t), g+1, t, path))

astar()
