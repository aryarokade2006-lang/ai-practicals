N = 8
board = [-1]*N

def solve(r):
    if r == N:
        return True

    for c in range(N):
        if all(board[i] != c and
               abs(board[i]-c) != r-i
               for i in range(r)):

            board[r] = c

            if solve(r+1):
                return True

            board[r] = -1

    return False

solve(0)

for r in range(N):
    print(' '.join('Q' if board[r] == c else '.'
                   for c in range(N)))
